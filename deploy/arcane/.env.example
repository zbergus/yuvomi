# ==============================================================================
# Yuvomi Environment Configuration for Arcane / TrueNAS
# ==============================================================================

# Image tag (default is 'main' from ghcr.io/zbergus/yuvomi)
YUVOMI_TAG=main

# Port and address mapping
YUVOMI_PUBLISH_ADDR=0.0.0.0
YUVOMI_PORT=3000

# Required: Generate a 64-char hex string: `openssl rand -hex 32`
SESSION_SECRET=replace_with_a_secure_random_64_character_hex_secret

# Optional: SQLCipher encryption key for the database (leave empty for unencrypted SQLite)
DB_ENCRYPTION_KEY=

# Enable private network access for self-hosted LAN recipe providers (e.g., Norish at http://192.168.0.63:9096)
RECIPE_PROVIDER_ALLOW_PRIVATE_NETWORK=true

# Persistent storage paths on host / TrueNAS dataset
YUVOMI_DATA_DIR=/mnt/apps/yuvomi/data
YUVOMI_BACKUP_DIR=/mnt/apps/yuvomi/backups
YUVOMI_MODULES_DIR=/mnt/apps/yuvomi/modules
YUVOMI_DOCUMENTS_DIR=/mnt/apps/yuvomi/documents

# Optional local document storage
DOCUMENT_STORAGE_LOCAL_ENABLED=false
DOCUMENT_STORAGE_LOCAL_PATH=/documents

# Reverse proxy settings (adjust if placing behind Traefik/Caddy/Cloudflare)
BASE_URL=
SESSION_SECURE=false
TRUST_PROXY=loopback
